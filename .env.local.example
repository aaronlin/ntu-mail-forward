# NTU POP3/SMTP polling config.
# Copy to .env.local and fill the values locally. .env.local is gitignored.

NTU_MAIL_USER=your-ntu-username
NTU_MAIL_PASSWORD=replace-with-password
NTU_POP3_HOST=msa.ntu.edu.tw
NTU_POP3_PORT=995
NTU_SMTP_HOST=smtps.ntu.edu.tw
NTU_SMTP_PORT=465
NTU_FORWARD_TO=your-forward-address@example.com

# Optional: set if SMTP rejects the default From address.
# NTU_FORWARD_FROM=your-ntu-address@example.edu
