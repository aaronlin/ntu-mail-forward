<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.ntu-mail-forward.cleanup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/path/to/ntu-mail-forward/launchd/run_with_error_email.sh</string>
    <string>ntu-mail-forward-cleanup</string>
    <string>/Users/example/path/to/ntu-mail-forward/.local/logs/ntu-mail-forward-cleanup.out.log</string>
    <string>/Users/example/path/to/ntu-mail-forward/.local/logs/ntu-mail-forward-cleanup.err.log</string>
    <string>/path/to/python3</string>
    <string>-m</string>
    <string>ntu_mail_forward.cli</string>
    <string>--cleanup-expired</string>
  </array>

  <key>StartInterval</key>
  <integer>86400</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/example/path/to/ntu-mail-forward/.local/logs/ntu-mail-forward-cleanup.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/example/path/to/ntu-mail-forward/.local/logs/ntu-mail-forward-cleanup.err.log</string>
</dict>
</plist>
